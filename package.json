{
  "name": "iraqi-film-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Iraqi film studio: OpenAI director and LTX-2.5 on Modal",
  "scripts": {
    "start": "node server.mjs",
    "check": "node tools/check.mjs && tsc --noEmit && tsc -p tsconfig.network.json",
    "test": "node --test tests/*.test.mjs",
    "build": "node tools/build.mjs",
    "engine:setup": "node engine/setup.mjs",
    "build:network": "node tools/build-network.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "pg": "8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
