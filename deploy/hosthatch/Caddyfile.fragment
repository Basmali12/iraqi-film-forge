# TEMPLATE ONLY. Do not insert into the shared live Caddyfile without approval.
# Replace the reserved domain with an owner-approved domain and verify DNS first.
film.example.invalid {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
    }
    reverse_proxy 127.0.0.1:3107
}
