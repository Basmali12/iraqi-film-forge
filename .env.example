OPENROUTER_API_KEY=
PORT=3000
HOST=127.0.0.1
# Never place API keys into GitHub Pages or public source code.

# Engine management: non-secret configuration only. See docs/ENGINE-SETUP.txt.
ENGINE_DATA_DIR=.engine-data
ENGINE_ORIGIN=https://localhost:3443
ENGINE_ALLOWED_ORIGINS=https://localhost:3443
ENGINE_ALLOW_PAID_ACTIONS=NO
ENGINE_COOKIE_SAME_SITE=strict
ENGINE_TRUST_PROXY=
ENGINE_TLS_CERT=
ENGINE_TLS_KEY=
ENGINE_PUBLIC_API_ORIGIN=
# Windows: setup provisions a DPAPI-wrapped key. Linux: inject ENGINE_MASTER_KEY
# from your server secret manager, never from frontend code or this example.
# Provision the admin password via a temporary environment variable / hidden prompt.
# Modal and HF tokens belong in the authenticated HTTPS form, not in this file.
