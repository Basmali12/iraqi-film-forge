PORT=3000
HOST=127.0.0.1
# Never place API keys into GitHub Pages or public source code.

# Engine management: non-secret configuration only. See docs/ENGINE-SETUP.txt.
ENGINE_DATA_DIR=.engine-data
ENGINE_ORIGIN=https://localhost:3443
ENGINE_ALLOWED_ORIGINS=https://localhost:3443
ENGINE_ALLOW_PAID_ACTIONS=NO
ENGINE_COOKIE_SAME_SITE=strict
ENGINE_TRUST_PROXY=
ENGINE_TLS_CERT=
ENGINE_TLS_KEY=
ENGINE_PUBLIC_API_ORIGIN=
ENGINE_PREVIEW_PASSWORD_GATE=NO
ENGINE_DATABASE_DRIVER=sqlite
# HostHatch staging uses postgres explicitly, no automatic SQLite import.
ENGINE_DATABASE_HOST=127.0.0.1
ENGINE_DATABASE_PORT=5432
ENGINE_DATABASE_NAME=iraqi_film_forge
ENGINE_DATABASE_USER=iff_app
ENGINE_DATABASE_PASSWORD_FILE=
ENGINE_MASTER_KEY_FILE=
# Windows: setup provisions a DPAPI-wrapped key. Linux: inject ENGINE_MASTER_KEY
# from your server secret manager, never from frontend code or this example.
# Provision the admin password via a temporary environment variable / hidden prompt.
# Modal and HF tokens belong in the authenticated HTTPS form, not in this file.

# Set only AFTER separately approved CPU worker deployment in basm1998ali.
ENGINE_CLOUD_TRANSFER_APP=
# Expected value after validation: iff-ltx25-cloud-copy-v1

# Optional native-audio cleanup: pinned root-owned CPU executable, no CUDA/TTS.
ENGINE_AUDIO_CLEANUP_BIN=
ENGINE_AUDIO_CLEANUP_SHA256=
ENGINE_FFMPEG_BIN=ffmpeg
ENGINE_FFPROBE_BIN=ffprobe
